{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"erasableSyntaxOnly": true,
		"strict": true
	},
	"include": ["src/**/*.ts"]
}
